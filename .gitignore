__pycache__/

notebooks/

invest-data/

# Local agent / tooling artifacts — regenerable working state, not plugin code.
# (understand-anything analysis cache + graph; Claude Code local settings.)
.understand-anything/
.claude/

# Snapshot-mismatch dumps (tests/helpers.lua's t.snapshot, T0 plan-testing).
# Committed goldens live in tests/snapshots/*.txt; .actual.txt is only the
# throwaway "what we actually got" side of a failing run, for local diffing.
tests/snapshots/*.actual.txt

# T7 corpus (docs/plan-testing.md T7): gap reports are regenerated every
# `make test` run, not goldens — see tests/corpus.lua's Gaps:write. Corpus
# level-3 transcripts are optional/unstable per-notebook (unlike the curated
# tests/transcripts/ corpus, which IS committed) and live in a separate tree
# for exactly that reason; a maintainer who verifies one is stable can still
# `git add -f` it.
tests/corpus/*.gaps.txt
tests/corpus/transcripts/
