{"op": "kernel-ready", "data": {"op": "kernel-ready", "cell_ids": ["<cell-1>", "<cell-2>", "<cell-3>", "<cell-4>", "<cell-5>"], "codes": ["import marimo as mo", "# ui.table accepts a list of rows as dicts, or a dict mapping column names to values,\n# or a dataframe-like object\ntable = mo.ui.table(\n    [\n        {\"first_name\": \"Michael\", \"last_name\": \"Scott\"},\n        {\"first_name\": \"Jim\", \"last_name\": \"Halpert\"},\n        {\"first_name\": \"Pam\", \"last_name\": \"Beesly\"},\n    ],\n    # Show full name on hover for each row using column placeholders\n    hover_template=\"{{first_name}} {{last_name}}\",\n    # Add header tooltip for column headers (shown via info icon + title)\n    header_tooltip={\n        \"first_name\": \"Employee's first name\",\n        \"last_name\": \"Employee's last name\",\n    },\n)\ntable", "# Per-cell hover: provide a callable for finer control\ndef cell_hover(row_id: str, column_name: str, value) -> str:\n    return f\"{row_id}:{column_name}={value}\"\n\nhover_table = mo.ui.table(\n    [{\"a\": i, \"b\": i * i} for i in range(8)],\n    hover_template=cell_hover,\n)\nhover_table", "table.value", "# Demonstrate a long table with a sticky header and a custom max height\nlong_rows = [{\"row\": i, \"first_name\": f\"First {i}\", \"last_name\": f\"Last {i}\"} for i in range(200)]\nlong_table = mo.ui.table(\n    long_rows,\n    pagination=False,\n    max_height=300,\n)\nlong_table"], "names": ["_", "_", "_", "_", "_"], "layout": null, "configs": [{"column": null, "disabled": false, "hide_code": false}, {"column": null, "disabled": false, "hide_code": false}, {"column": null, "disabled": false, "hide_code": false}, {"column": null, "disabled": false, "hide_code": false}, {"column": null, "disabled": false, "hide_code": false}], "resumed": false, "ui_values": {}, "last_executed_code": {}, "last_execution_time": {}, "app_config": {"width": "compact", "app_title": null, "layout_file": null, "css_file": null, "html_head_file": 